{
  "name": "@zatteogit/vulcan",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "ds-bundle/"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:semantics": "node scripts/check-semantics.mjs",
    "check:semantics:update": "node scripts/check-semantics.mjs --update",
    "check:css-tokens": "node scripts/check-css-tokens.mjs",
    "check:css-tokens:update": "node scripts/check-css-tokens.mjs --update",
    "ds:check": "node --test scripts/ds-tier-guard.test.mjs && node scripts/ds-tier-guard.mjs",
    "ds:report": "node scripts/ds-tier-guard.mjs --report",
    "architecture:check": "tsx scripts/architecture-guard.test.ts && tsx scripts/architecture-guard.ts",
    "semantics:check": "tsx scripts/semantic-guard.test.ts && tsx scripts/semantic-guard.ts",
    "dead-code:check": "tsx scripts/dead-code-guard.ts",
    "i18n:check": "tsx scripts/i18n-ui-guard.test.ts && tsx scripts/i18n-ui-guard.ts",
    "visual:check": "node scripts/visual-check.mjs",
    "visual:self-test": "node scripts/visual-check.mjs --self-test",
    "lint": "npm run check:tokens && npm run check:semantics && npm run check:css-tokens && npm run ds:check && npm run i18n:check && npm run architecture:check && npm run semantics:check && npm run dead-code:check",
    "debug:pull": "node scripts/debug-pull.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "quality:check": "npm run typecheck && npm test && npm run lint",
    "quality:full": "npm run quality:check && npm run build && npm run visual:check",
    "verify": "npm run quality:check"
  },
  "dependencies": {
    "@radix-ui/react-switch": "1.1.3",
    "lucide-react": "0.487.0",
    "motion": "12.40.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router": "7.18.1",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "^4.12.1",
    "tailwindcss": "4.1.12",
    "ts-morph": "^27.0.2",
    "tsx": "^4.23.1",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "^3.2.6"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
